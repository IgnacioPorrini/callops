{
  "manifest_version": 3,
  "name": "Queue Tab Launcher",
  "version": "1.6.0",
  "description": "Detecta colas de llamadas entrantes y abre automáticamente las pestañas de trabajo configuradas.",
  "author": "Ignacio",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>",
    "file://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac":     "Alt+Q"
      },
      "description": "Abrir Queue Tab Launcher"
    },
    "manual-trigger": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac":     "Alt+Shift+Q"
      },
      "description": "Disparar detección manual de cola"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Queue Tab Launcher (Alt+Q)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
